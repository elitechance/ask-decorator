{
  "name": "ask-decorator",
  "version": "2.0.0",
  "description": "Alexa ask-sdk Typescript Decorator",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "deploy": "npm run build && cd dist && npm publish && cd -",
    "deploy:local": "npm run build && cd dist && npm link && cd -",
    "build": "rm -rf dist && tsc && cp package*.json *.md dist",
    "start": "tsc -w",
    "coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elitechance/ask-decorator.git"
  },
  "keywords": [
    "alexa",
    "ask",
    "typescript"
  ],
  "author": "Ethan Dave B. Gomez",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/elitechance/ask-decorator/issues"
  },
  "homepage": "https://github.com/elitechance/ask-decorator#readme",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "ask-sdk-core": "^2.14.0",
    "ask-sdk-model": "^1.86.0"
  }
}
